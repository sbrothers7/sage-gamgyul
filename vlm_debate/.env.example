# 이 파일을 .env 로 복사한 뒤 채우세요. .env 는 절대 공유/커밋 금지.

# ── 로컬 모델 (무료, 권장) ─────────────────────────────────────────────
# 1_setup.bat --apply 를 실행하면 이 줄이 자동으로 채워집니다.
OLLAMA_MODELS=
OLLAMA_HOST=http://localhost:11434

# ── 상용 API (선택) ────────────────────────────────────────────────────
# 넷 다 필요하지 않습니다. 있는 것만 채우면 해당 에이전트만 사용됩니다.
GEMINI_API_KEY=
GEMINI_MODELS=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=

# ── 공통 ───────────────────────────────────────────────────────────────
# 데이터셋: 폴더 경로 또는 data/*.json 명세 파일
CDDM_ROOT=data/citrusB_mendeley.json
VP_OUTPUT=results

N_IMAGES=10
N_DEBATE=3
SEED=42
