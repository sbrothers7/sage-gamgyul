# 이 파일을 .env 로 복사해서 쓰세요. .env 는 절대 커밋하지 마세요.

# ── 로컬 모델 (Ollama) ─────────────────────────────────────────────────
# 본 실험에 쓴 3개 모델 (약 → 강). 없으면 `ollama pull <이름>` 으로 받습니다.
OLLAMA_MODELS=llava:7b,qwen2.5vl:7b,qwen2.5vl:3b
OLLAMA_HOST=http://localhost:11434

# ── 데이터 ─────────────────────────────────────────────────────────────
# 이미지 원본 위치. data/*.json 의 상대경로는 여기를 기준으로 합니다.
# 비워두면 macOS·Linux: ~/citrus-data , Windows: D:/citrus-data 또는 C:/citrus-data
CITRUS_DATA=
# 기본 데이터셋 명세
CDDM_ROOT=data/citrusA_mendeley_4cls.json
VP_OUTPUT=results

# ── 상용 API (선택, 본 실험에서는 사용하지 않음) ────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

N_IMAGES=10
N_DEBATE=3
SEED=42
